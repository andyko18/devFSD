#!/usr/bin/env bash
# specops-ko push 전 전체 스위트 게이트 (205 스위트 · doc-lock: suite-count · 작업자 풀 병렬 20260911. 동일 비문서 트리면 마커로 skip)
#
# 소요는 **머신 부하가 좌우한다** — 절대값으로 읽지 말 것. 같은 날 같은 트리 실측:
#   2026-09-11 실측 median: 병렬 382s(5회) · 직렬(SPECOPS_RUN_ALL_JOBS=1) 813s(3회).
# 아래 안내문의 소요 표기는 병렬 median 을 가리킨다. 다시 재려면 `time bash scripts/tests/run-all.sh`.
#
# pre-commit 은 5초짜리 정합만 본다(로컬 반복 비용). 원격에 나가기 직전 한 번,
# run-all.sh(=릴리즈 pre-flight 와 동일 게이트) 전체를 돌린다.
#
# 탈출구(주권, 5원칙 4): git push --no-verify
set -uo pipefail

# ★ git 이 훅에 export 하는 저장소 변수를 가장 먼저 지운다 (20261007-prepush-gitdir).
#   링크 worktree 에서는 GIT_DIR 가 **절대경로**라, 아래 run-all 안의 테스트 픽스처(`cd $tmp && git init/commit/config`)가
#   임시 디렉터리가 아니라 **공유 실저장소**에 실행된다(2026-10-06 사고: core.worktree·user.name 주입, 로컬 main 이동,
#   잡 브랜치 19개). 비링크 repo 는 상대경로(.git)라 우연히 안전했다. 훅 cwd 는 worktree 루트이므로 지운 뒤에도
#   아래 rev-parse 가 같은 저장소를 찾는다.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$ROOT" 2>/dev/null || exit 0

RUN_ALL="scripts/tests/run-all.sh"
# 관할 한정 — specops 플러그인 repo 가 아니면 면제
[ -f "$RUN_ALL" ] || exit 0

# 재귀 가드 — run-all 내부에서 파생된 push(테스트·릴리즈 dry-run)는 재실행하지 않는다
[ "${SPECOPS_RUN_ALL:-}" = "1" ] && exit 0

# 삭제-only push 면제 — 보낼 커밋이 없다
# stdin: <local ref> <local sha> <remote ref> <remote sha>
has_update=0
while read -r _lref lsha _rref _rsha; do
  [ -n "${lsha:-}" ] || continue
  case "$lsha" in
    *[!0]*) has_update=1 ;;   # all-zero = 삭제
  esac
done
[ "$has_update" -eq 1 ] || exit 0

# origin main CI 가 red 면 경고 (~10분+ 스위트를 돌기 전에 알린다 — 차단은 하지 않는다).
# 판정 로직은 전부 check-ci-status.sh 에 있다 (훅 본문 인라인 금지 — 중복 판정은 드리프트를 낳는다).
# 면제 4종 뒤에 두는 것이 계약이다 — 앞에 두면 비-specops repo 에서 gh 를 부르는 월권(5원칙 4).
CI_CHECK="scripts/_internal/check-ci-status.sh"
[ -f "$CI_CHECK" ] && bash "$CI_CHECK" || true

# full-suite 마커 skip (20260908) — 면제 4종 뒤에 둔다(:33 계약과 동형).
#   run-all 이 통과시킨 트리(`.specops/.full-suite-pass`)와 지금 트리가 같으면 그 10분+ 를 다시 물지 않는다.
#   판정은 full-suite-fresh.sh 한 곳에 있다 — verify 단계와 공유한다(20261005). 훅 본문 인라인 금지:
#   두 소비자의 판정이 갈라지면 한쪽만 생략 방향으로 틀린다. 헬퍼 부재도 STALE 과 같이 전체 실행이다.
#   fail-closed: 부재·읽기실패·NO_GIT·불일치·SPECOPS_FORCE_FULL(값 무관) 은 전부 전체 실행이다.
FSP_FRESH="scripts/_internal/full-suite-fresh.sh"
if [ -f "$FSP_FRESH" ] && bash "$FSP_FRESH" >/dev/null 2>&1; then
  cat >&2 <<'EOF'
▶ pre-push: 동일 트리가 이미 전체 스위트를 통과해 건너뜁니다.
  강제 실행: SPECOPS_FORCE_FULL=1 git push
EOF
  exit 0
fi

echo "▶ pre-push: run-all.sh 전체 스위트 실행 중 (205 스위트 병렬 — ~7분, 머신이 바쁘면 그 이상)…" >&2  # doc-lock: suite-count
out=$(bash "$RUN_ALL" --quiet 2>&1); rc=$?
if [ "$rc" -ne 0 ]; then
  cat >&2 <<EOF
✋ push 차단 — 전체 스위트 실패
$(printf '%s' "$out" | grep -E '^(FAILED|====|FAIL)' | head -20)

재현: bash scripts/tests/run-all.sh
의도적으로 넘기려면(주권): git push --no-verify
EOF
  exit 1
fi

printf '%s\n' "$out" | tail -1 >&2
exit 0
